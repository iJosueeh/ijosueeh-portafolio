---
// FooterArcade.astro
---

<footer
  class="w-full max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between text-[10px] sm:text-[11px] font-mono text-purple-200/60 py-2 sm:py-2.5 px-4 sm:px-6 md:px-8 border-t border-arcade-border/80 z-10 gap-1.5 sm:gap-0 bg-arcade-surface/40 backdrop-blur-md shrink-0"
  data-purpose="arcade-footer"
>
  {/* Copyright Status */}
  <div class="tracking-wider flex items-center gap-1.5">
    <span class="text-arcade-pink font-arcade text-[8px] sm:text-[9px]">©</span>
    <span
      >2025 iJOSUEEH <span class="text-purple-400/40">//</span> TODOS LOS DERECHOS
      RESERVADOS</span
    >
  </div>

  {/* Center Blinking Coin Callout */}
  <div
    class="text-center font-arcade text-[9px] sm:text-[10px] tracking-wider text-arcade-pink animate-arcade-blink glow-magenta"
  >
    INSERTA MONEDA O PRESIONA INICIO
  </div>

  {/* Technical Architecture Meta */}
  <div class="tracking-wider text-slate-300 hidden md:block">
    <span class="text-arcade-cyan font-bold">MOTOR:</span> ASTRO 5 + REACT <span
      class="text-purple-400/40">//</span
    >
    <span class="text-arcade-magenta font-bold">ESTILO:</span> TAILWIND
  </div>
</footer>
